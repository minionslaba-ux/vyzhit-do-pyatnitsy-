[{"id":"cast_fedor_1","cast":"fedor","stage":1,"who":"Фёдор","text":"Новый сосед по столу Фёдор протягивает руку и сразу спрашивает: «Зарядки не найдётся? Верну до обеда, честное слово».","answers":{"left":{"label":"Своя нужнее","effects":{"psyche":5,"energy":0,"boss":0,"colleagues":-5},"rel":-1},"right":{"label":"Держите, Фёдор","effects":{"psyche":0,"energy":-5,"boss":0,"colleagues":10},"rel":1}}},{"id":"cast_fedor_2","cast":"fedor","stage":2,"who":"Фёдор","text":"Фёдор переезжает: «Всего двадцать коробок и пианино. Суббота, восемь утра. Пицца с меня!»","answers":{"left":{"label":"У меня аллергия на пианино","effects":{"psyche":5,"energy":5,"boss":0,"colleagues":-10},"rel":-1},"right":{"label":"Возьму перчатки","effects":{"psyche":-5,"energy":-20,"boss":0,"colleagues":15},"rel":1}}},{"id":"cast_fedor_3","cast":"fedor","stage":3,"who":"Фёдор","text":"Фёдор приносит в офис кота Бублика: «В съёмной нельзя с животными. Пусть посидит у вас под столом, он тихий».","answers":{"left":{"label":"Под столом место ногам","effects":{"psyche":5,"energy":0,"boss":0,"colleagues":-5},"rel":-1},"right":{"label":"Бублик, добро пожаловать","effects":{"psyche":10,"energy":0,"boss":-10,"colleagues":5},"rel":1}}},{"id":"cast_fedor_4","cast":"fedor","stage":4,"who":"Фёдор","text":"Квартира у Фёдора снова не сложилась — второй переезд за полгода. «Коробки те же, пианино то же. Дорогу вы помните!»","answers":{"left":{"label":"Помню. Поэтому нет","effects":{"psyche":5,"energy":0,"boss":0,"colleagues":-10},"rel":-1},"right":{"label":"Захвачу скотч","effects":{"psyche":0,"energy":-15,"boss":0,"colleagues":10},"rel":1}}},{"id":"cast_fedor_5","cast":"fedor","stage":5,"who":"Фёдор","text":"К столу идёт Босс. Фёдор шепчет из-под стола: «Скажите, что я на встрече. У Бублика ветеринар по видеосвязи».","answers":{"left":{"label":"Он под столом, вот","effects":{"psyche":0,"energy":0,"boss":5,"colleagues":-10},"rel":-1},"right":{"label":"У него срочная встреча","effects":{"psyche":-5,"energy":0,"boss":-10,"colleagues":10},"rel":1}}},{"id":"cast_fedor_6","cast":"fedor","stage":6,"who":"Фёдор","text":"Ваша зарядка вернулась от Фёдора спустя полгода: в изоленте, с наклейкой «Бублик» и почему-то чужим штекером.","answers":{"left":{"label":"Потребовать новую","effects":{"psyche":5,"energy":0,"boss":0,"colleagues":-5},"rel":-1},"right":{"label":"Оставьте её себе, Фёдор","effects":{"psyche":-5,"energy":-5,"boss":0,"colleagues":10},"rel":1}}},{"id":"cast_fedor_7","cast":"fedor","stage":7,"who":"Фёдор","text":"Фёдор уезжает к родителям: «Подержите Бублика неделю? Он ест только паштет с уткой и спит только на ноутбуках».","answers":{"left":{"label":"Подскажу зоогостиницу","effects":{"psyche":5,"energy":0,"boss":0,"colleagues":-5},"rel":-1},"right":{"label":"Освобожу ноутбук","effects":{"psyche":-5,"energy":-15,"boss":0,"colleagues":10},"rel":1}}},{"id":"cast_fedor_8","cast":"fedor","stage":8,"who":"Фёдор","text":"Фёдор купил квартиру! Переезд последний, клянётся он. Новоселье в пятницу, и вы в списке «самых своих».","answers":{"left":{"label":"Пятница — святое","effects":{"psyche":10,"energy":5,"boss":0,"colleagues":-10},"rel":-1},"right":{"label":"Приду с зарядкой в подарок","effects":{"psyche":5,"energy":-10,"boss":0,"colleagues":15},"rel":1}}},{"id":"cast_fedor_9","cast":"fedor","stage":0,"who":"Фёдор","text":"Босс ищет виноватого в сорванном отчёте. Фёдор встаёт: «Это я задержал. Мы с Бубликом всё переделаем к утру».","answers":{"left":{"label":"Принять спасение","effects":{"psyche":5,"energy":0,"boss":15,"colleagues":-5},"rel":0},"right":{"label":"Разделить вину пополам","effects":{"psyche":0,"energy":-5,"boss":5,"colleagues":10},"rel":0}},"payoff":"friend"},{"id":"cast_fedor_10","cast":"fedor","stage":0,"who":"Фёдор","text":"Фёдор переезжает к другому столу и забирает ваш монитор, кресло и, кажется, зарядку. «Мне было нужнее».","answers":{"left":{"label":"Отбить кресло с боем","effects":{"psyche":5,"energy":-10,"boss":0,"colleagues":-10},"rel":0},"right":{"label":"П